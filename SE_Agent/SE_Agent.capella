          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="f1a109a8-5a60-4d83-89a0-a92b4ff4e975" name="Manage Prompts" description="&lt;p>Retrieve, adapt, and format prompts.&lt;/p>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="ae7a0a2f-86e5-4906-8e96-ae8b3726bfa2" name="Trace Action" description="&lt;p>Record decision chain and tool results.&lt;/p>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="c19ed751-1744-4879-99fc-447c674a6ece" name="Manage Contract Transitions"
              description="&lt;p>Maintain and enforce the active contract governing agent behavior.&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Switch from DEFAULT to SESSION when a Guided Session is initiated (e.g., via execute_prompt_for_session from a prompt artifact).&lt;/li>&#xA;&#x9;&lt;li>Switch from SESSION back to DEFAULT when the user finishes or cancels the session.&lt;/li>&#xA;&#x9;&lt;li>Ensure that contract changes are applied consistently across the Decision and Reasoning Core, Interactive Console, and Session State Store.&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p>.&lt;/p>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="0bce1bc1-30b8-45db-88c0-46602be954fc" name="Interact with User"
              description="&lt;p>Handle bidirectional interaction with the user, including chat messages, system notifications, and context prompts. Forward user input to the Decision and Reasoning Core according to the active contract (DEFAULT vs SESSION) and render the agent&amp;rsquo;s responses.&lt;/p>&#xA;"/>
