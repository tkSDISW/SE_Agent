              id="c53072e8-3bce-41c4-9e55-e06a3a5ccbc9" name="Support Interface and Dialog Space"
              description="&lt;p>Provide UI layouts and widgets (e.g., columns, tabs, text areas, buttons) to visualize artifacts, tool results, and conversational content. In Guided Session mode, present a multi-pane layout that surfaces:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Available prompt artifacts,&lt;/li>&#xA;&#x9;&lt;li>Optional attachments,&lt;/li>&#xA;&#x9;&lt;li>The active session transcript and controls.&lt;/li>&#xA;&lt;/ul>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="e5a23416-a67f-4485-a982-b8749cbfbe0a" name="FIP 1"/>
