              <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                  id="1cafc485-d5b5-4d2f-905d-a85a78f9733b" name="Session State Store"
                  description="&lt;p>Maintains state related to interactive sessions and broader context.&lt;br />&#xA;For Guided Sessions, it stores:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>The selected prompt seed and attachments for the session,&lt;/li>&#xA;&#x9;&lt;li>The evolving session transcript (user and assistant turns),&lt;/li>&#xA;&#x9;&lt;li>References to artifacts created at session completion (e.g., session summary).&lt;/li>&#xA;&#x9;&lt;li>It supports synchronization with context memory and other components that need a persistent view of session and contract-related state.&amp;quot;&lt;/li>&#xA;&lt;/ul>&#xA;">
                <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                    id="062f9ab7-0a6e-4906-8430-261546dad758" targetElement="#4026a46b-41ff-4a91-9b3d-5a50ca7ebe9e"
                    sourceElement="#1cafc485-d5b5-4d2f-905d-a85a78f9733b"/>
                <ownedFunctionalAllocation xsi:type="org.polarsys.capella.core.data.fa:ComponentFunctionalAllocation"
                    id="9ec9818f-abde-41aa-b942-ac387bbd4949" targetElement="#9d82f6f4-7001-443f-a85c-41f82a608763"
                    sourceElement="#1cafc485-d5b5-4d2f-905d-a85a78f9733b"/>
                <ownedFeatures xsi:type="org.polarsys.capella.core.data.fa:ComponentPort"
                    id="dc114135-fd3e-4c47-b050-c86ac441ccc3" name="CP 1" orientation="IN"
                    kind="FLOW">
