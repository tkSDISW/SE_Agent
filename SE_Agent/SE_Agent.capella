            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="a30c8fcf-ad6c-4551-9ec8-7695d7966559" description="Create a workspace for a routine execution. Defaults to mode=folder (outputs at workspace/&lt;routine_id>/&lt;date>/ on the current branch — no branch created). Pass mode=branch for long-running/failure-prone routines or team routines needing write isolation — creates workspace/&lt;routine_id>-&lt;date> instead.&lt;/date>&lt;/routine_id>&lt;/date>&lt;/routine_id>"
                name="Create Workspace"/>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="052a695d-90c3-4c6c-98a1-08d585dc6f7b" description="Write a typed artifact into the workspace (folder or branch), committed immediately. Takes workspace_id — either {routine_id}/{date} for folder mode or workspace/{routine_id}-{date} for branch mode."
                name="Write Workspace Artifact"/>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="e301fb72-49c8-424e-966f-7ce188770d10" description="Read one workspace output (promotion primitive) — never disrupts the session&amp;#x27;s current branch either way."
                name="Read Workspace Artifact"/>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
                id="eeeb0cb4-74a6-4c68-a3bd-a0a631690191" description="Inspect active workspaces; each result is tagged mode: folder or branch."
                name="List Workspaces"/>
            <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
