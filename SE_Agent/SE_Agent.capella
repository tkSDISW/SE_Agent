              id="4026a46b-41ff-4a91-9b3d-5a50ca7ebe9e" name="Support Session and Context State"
              description="&lt;p>Persist and retrieve session and context information, including:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Session identifiers and active package,&lt;/li>&#xA;&#x9;&lt;li>Session seed text (from prompt artifacts),&lt;/li>&#xA;&#x9;&lt;li>Contract mode flags relevant to session operations.&lt;/li>&#xA;&#x9;&lt;li>Provide this state to Decision and Reasoning Core and Contract Manager as needed.&lt;/li>&#xA;&lt;/ul>&#xA;&#xA;&lt;p>.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="52b2d155-8895-4aec-8cb7-57735329d8e1" name="FIP 1"/>
