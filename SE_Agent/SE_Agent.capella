                id="973eaf04-e149-479a-b7cd-cf67139d83b5" name="FIP 2"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="2d70f283-739d-4564-b76d-8ea5dd7761a4" name="Accept as WS Content"
              description="&lt;p>Receives the reconstructed workspace state and integrates it into the active session, marking it as the current workspace memory available to the Decision and Reasoning Core and tools.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="df549b70-9d84-4fb5-82cf-c213c2c40d15" name="FIP 1"/>
