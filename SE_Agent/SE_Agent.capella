                id="99754797-eb6f-406b-8817-4dd6d560498f" name="FIP 1"/>
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="8e070fe6-ffbb-4b6b-8f31-33bf512840eb" name="FIP 2"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="5dfb36d6-e7af-47cc-9451-b2ecfa0f3548" name="FOP 1"/>
