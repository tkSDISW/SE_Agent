          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="5acb6e05-9652-4871-9818-c5aec9cf72bd" name="Retrieve Artifact "
              description="&lt;p>Manage persistence and versioning.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="a33c9b5b-63b0-47ce-8eb8-e90417426bf5" name="FIP 1"/>
