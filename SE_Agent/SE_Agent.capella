              <ownedLogicalComponents xsi:type="org.polarsys.capella.core.data.la:LogicalComponent"
                  id="6d0cdb44-01c7-4022-b427-050322a8b1e9" name="Descision and Reasoning Core"
                  description="&lt;p>Implements the agent&amp;rsquo;s reasoning behavior, including inspection of artifacts, tool selection and orchestration, and contract-dependent response generation. In DEFAULT contract it behaves as a tool-aware Knowledge Partner; in SESSION contract it acts as a lightweight facilitator, driving turn-by-turn conversation without invoking tools and coordinating with the Session State Store and Contract Manager.&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li data-end=&quot;1134&quot; data-start=&quot;1105&quot;>Conversation / Turn Manager&lt;/li>&#xA;&#x9;&lt;li data-end=&quot;1171&quot; data-start=&quot;1139&quot;>Prompt Manager / Mode Selector&lt;/li>&#xA;&#x9;&lt;li data-end=&quot;1205&quot; data-start=&quot;1176&quot;>Tool Orchestrator / Planner&lt;/li>&#xA;&#x9;&lt;li data-end=&quot;1270&quot; data-start=&quot;1210&quot;>&lt;strong data-end=&quot;1248&quot; data-start=&quot;1210&quot;>Workspace Memory (Working Context)&lt;/strong> &amp;larr; &lt;em data-end=&quot;1270&quot; data-start=&quot;1252&quot;>new explicit box&lt;/em>&lt;/li>&#xA;&lt;/ul>&#xA;">
