          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="e015d362-a194-41d6-bce6-4b4fa10545d9" name="Peform Functions">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="cc4b6442-918d-42db-87b7-78e05c8c1be5" name="FIP 1"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="def1457d-9c62-4e95-99e8-159ef702feb7" name="Present Guided Session Controls and Views"
              description="&lt;p>Manage the specific UI affordances for Guided Sessions:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>&amp;ldquo;Start Session from Prompt&amp;rdquo; action and attachment selection,&lt;/li>&#xA;&#x9;&lt;li>Display of session status (active / none / finished),&lt;/li>&#xA;&#x9;&lt;li>&amp;ldquo;Finish Session&amp;rdquo; and &amp;ldquo;Cancel Session&amp;rdquo; controls,&lt;/li>&#xA;&#x9;&lt;li>Visualization of the created summary artifact when the session concludes.&lt;/li>&#xA;&lt;/ul>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="ffff353d-ca2c-4dba-b3fe-1cb0facf1746" name="Facilitate Guided Session Turn"
              description="&lt;p>When the contract is SESSION, interpret each user message as part of an ongoing Guided Session.&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Use the session seed (from the selected prompt artifact), current transcript, and any attached artifacts to generate a concise facilitator response.&lt;/li>&#xA;&#x9;&lt;li>Do not call tools in this mode; produce purely conversational guidance (questions, nudges, or next steps).&lt;/li>&#xA;&lt;/ul>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="bf591ca5-4bfd-43a9-b0a2-8f76a465cd0f" name="FIP 1"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="12bc2fc3-2f1a-497e-82b8-f980a10c7490" name="Interpret Session Command"
              description="&lt;p>Detect session-related commands embedded in user input (e.g., &amp;ldquo;finish&amp;rdquo;, &amp;ldquo;finish session&amp;rdquo;, &amp;ldquo;cancel&amp;rdquo;, &amp;ldquo;abort&amp;rdquo;) and trigger:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Session summarization via the Session State Store,&lt;/li>&#xA;&#x9;&lt;li>Contract change requests toward the Contract Manager (from SESSION back to DEFAULT),&lt;/li>&#xA;&#x9;&lt;li>Cleanup of session data when canceled or finished.&lt;/li>&#xA;&lt;/ul>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="7504bc3b-c8d4-4470-9069-697681f1b697" name="FIP 1"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="c4d120f9-97d4-4dac-9651-9ed3c533927e" name="LogicalFunction 39"
              kind="SPLIT">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="4d047a89-468e-4e75-99ac-3c49a483a8ff" name="FIP 2"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="e4fcce9f-544b-4077-af0f-2012318ac723" name="FOP 1"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="9d75d0ce-0cf3-470c-aeb4-87b6f4acce83" name="FOP 2"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="401abea0-d3d0-4483-93ab-a3f6932d9c17" name="FOP 3"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="df029060-8e10-4016-b97e-f401d22e98ab" name="Evaluate Session Contract Triggers"
              description="&lt;p>Monitor events and state related to sessions, including:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>Session creation from a prompt artifact,&lt;/li>&#xA;&#x9;&lt;li>Presence of a pending session identifier,&lt;/li>&#xA;&#x9;&lt;li>User-issued finish/cancel commands.&lt;/li>&#xA;&#x9;&lt;li>Decide when the conditions for entering/exiting SESSION are met and inform Manage Contract Transitions to perform the actual mode switch.&lt;/li>&#xA;&lt;/ul>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="9d82f6f4-7001-443f-a85c-41f82a608763" name="Record Session Summary Artifacts"
              description="&lt;p>When a session is completed, record the linkage between:&lt;/p>&#xA;&#xA;&lt;ul>&#xA;&#x9;&lt;li>The session identifier and transcript,&lt;/li>&#xA;&#x9;&lt;li>The generated summary artifact (e.g., session_summary type). This enables later navigation from session history to its summary and supports replay or review features.&lt;/li>&#xA;&lt;/ul>&#xA;"/>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="8b9aaaf2-e258-4965-9d38-121f538ca56f" name="File Upload Tool " description="&lt;p>Receives a file selection from the user or UI, validates basic metadata (name, type, size), and forwards the file content to the ingestion function. Acts as the entry point for turning raw files into managed artifacts.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="85c042ff-9c58-4e43-9a3e-2cb5a62a8726" name="FIP 1"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="f9b18a4e-454a-4323-99df-7407f73d839a" name="FOP 1"/>
            <outputs xsi:type="org.polarsys.capella.core.data.fa:FunctionOutputPort"
                id="78b6c6cd-314a-4161-ade3-94b27db57d64" name="FOP 2"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="13e1bf4c-8d64-407d-90dd-22bb7b16c8d4" name="Ingest File">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="8d7d1794-f554-4d7f-8f84-c37ba38d80dd" name="FIP 2"/>
          </ownedFunctions>
          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="a597b8b0-9a73-46fc-bca4-11b1f9b5c1e8" name="Accept File Id" description="&lt;p>Receives file and vector-store identifiers from the ingestion function, validates them, and prepares a normalized reference structure that can be stored as part of an artifact&amp;rsquo;s data.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="b42bde69-fe3f-41a1-9c76-db84354ed0c3" name="FIP 1"/>
