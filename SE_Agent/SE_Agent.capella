          <ownedFunctions xsi:type="org.polarsys.capella.core.data.la:LogicalFunction"
              id="51fe3e91-e368-4756-9f26-d3cfe9671675" name="Recall Artifact" description="&lt;p>Retrieves a previously stored artifact from the Artifact Registry or Artifact &amp;amp; Trace Store based on an identifier, tag, or query, and provides its content and metadata to downstream functions.&lt;/p>&#xA;">
            <inputs xsi:type="org.polarsys.capella.core.data.fa:FunctionInputPort"
                id="711996dd-9db3-407a-9b5a-688ffa367c51" name="FIP 1"/>
